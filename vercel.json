{
  "buildCommand": "npm build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "VITE_APP_TITLE": "ISO 27001:2022 SOP Management",
    "VITE_APP_ID": "iso27001-sops"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
